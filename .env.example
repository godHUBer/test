# Auth stays disabled unless all three public settings are valid.
# SITE_URL must be the approved HTTPS origin, without path/query; never use request headers as its replacement.
SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, SERVER ONLY: used exclusively by owner-authorised invitation action.
# Configure through your hosting secret manager or ignored .env.local, never in Git/chat.
SUPABASE_SECRET_KEY=
# Do not configure remote credentials before the reviewed security migration is approved/applied.
# Existing editor accounts must be reassigned explicitly; missing security version blocks admin access.

# Public inventory reads are independent of staff sessions. Default is an explicitly labelled snapshot.
# Set to supabase only in an authorised environment after security/backup and connection verification.
# Invalid/missing live configuration shows an error; it never silently falls back to snapshot cars.
PUBLIC_INVENTORY_MODE=snapshot
# Optional server-only overrides for public reads (otherwise the NEXT_PUBLIC_* values above are used).
# These must reference the same approved project. Never put a secret/service key here.
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional SERVER-ONLY media broker credential for sanitised uploads/publication/signed previews.
# Missing key disables photo processing without disabling specification/status editing.
# Grant only in the approved deployment secret manager after security/backup gates.
# Never prefix with NEXT_PUBLIC_, place in browser code, or paste into chat/Git.
MEDIA_STORAGE_SECRET_KEY=

# Optional SERVER-ONLY Phase 5 online intake. Defaults off; mailto contact forms remain available.
# Requires PUBLIC_INVENTORY_MODE=supabase, HTTPS SITE_URL, and the reviewed Phase 5 migration.
# Do not enable for real customers until backup, provider, privacy and abuse-control gates pass.
BUSINESS_INTAKE_ENABLED=false
# Separate intake-broker service credential; never reuse a browser/publishable key.
INTAKE_SECRET_KEY=
# Random >=32-character server secret: signs short-lived forms and keys contact/network fingerprints.
# Keep stable across replicas/retries; store/rotate through your deployment secret manager, not Git/chat.
INTAKE_HASH_SECRET=
# OPTIONAL only if the deployment's trusted proxy overwrites this header and blocks direct origin access.
# Allowed: cf-connecting-ip or x-real-ip. Do not use caller-controlled forwarding headers.
# Leave blank without a verified proxy contract: contact/global limits still apply, network limits do not.
INTAKE_TRUSTED_IP_HEADER=
