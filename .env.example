# Sohan Automobile — static export (GitHub Pages) + live Supabase configuration.
# Copy to .env.local for local runs, or inject via your host/CI secret manager.
# Never commit real keys. Values marked SERVER ONLY / EDGE must never be prefixed
# with NEXT_PUBLIC_ and must never reach the browser bundle.

# --- Deployment (static export on GitHub Pages) ------------------------
# SITE_URL: exact approved HTTPS origin of the deployed app, no path/query.
# Used for canonicals, OG tags, robots/sitemap and auth callbacks.
SITE_URL=https://godhuber.github.io
# NEXT_PUBLIC_BASE_PATH: GitHub Pages project path prefix (the repo name).
# Empty for a domain root; "test" for https://<user>.github.io/test/.
# Must match the repo name so internal links/assets/SEO resolve under it.
NEXT_PUBLIC_BASE_PATH=test

# --- Public / shared settings ------------------------------------------
# Selected Supabase project (sohan-automobile). Public, non-secret project origin.
NEXT_PUBLIC_SUPABASE_URL=https://vxlxoiycolfojcnhnzfr.supabase.co
# Publishable / anon key only. The loader rejects sb_secret_ and service-role JWTs in this slot.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Public inventory source (read at build time for prerendering) ----
# snapshot = safe local default (labelled preview, never presented as current stock).
# supabase  = live reads from the selected project; public pages are prerendered at build.
# Invalid config fails closed, never snapshots.
PUBLIC_INVENTORY_MODE=supabase

# Optional SERVER-ONLY overrides for public reads (otherwise the NEXT_PUBLIC_* values are used).
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Staff authentication & invitations --------------------------------
# EDGE (invite-staff function): service key for the privileged GoTrue invite.
# Configure as a Supabase Edge Function secret, never in the browser bundle.
SUPABASE_SECRET_KEY=

# --- Optional media broker (media-publish Edge Function) ---------------
# EDGE: service key for the privileged draft→public photo copy.
# Missing key disables photo publication without disabling specification/status editing.
MEDIA_STORAGE_SECRET_KEY=

# --- Optional Phase 5 online intake (default off) ----------------------
# Requires PUBLIC_INVENTORY_MODE=supabase, HTTPS SITE_URL and the reviewed business workflow.
# Keep false until backup/privacy/abuse gates pass. When enabled, the intake form is
# prerendered and submissions go through the intake Edge Function.
BUSINESS_INTAKE_ENABLED=false
# INTAKE_SECRET_KEY=
# INTAKE_HASH_SECRET=
# OPTIONAL only if a trusted proxy overwrites this header and blocks direct origin access.
# Allowed: cf-connecting-ip or x-real-ip. Leave blank without a verified proxy contract.
# INTAKE_TRUSTED_IP_HEADER=
